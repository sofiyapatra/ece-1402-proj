eletable=\"false\"><mutation typename=\"tiles.Location\"></mutation><field name=\"VALUE\">location</field></block></value><statement name=\"HANDLER\"><block type=\"music_playable_play\"><field name=\"playbackMode\">music.PlaybackMode.UntilDone</field><value name=\"toPlay\"><shadow type=\"music_melody_playable\"><field name=\"melody\">music.powerUp</field></shadow></value><next><block type=\"variables_set\"><field name=\"VAR\" id=\"0;@4*BL*c^S.QDf/]$sd\">hasSword</field><value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value><next><block type=\"gameSplash\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"0\" _input_init=\"true\"></mutation><value name=\"title\"><shadow type=\"text\"><field name=\"TEXT\">\"LEGENDARY SWORD HAS BEEN ACQUIRED!\"</field></shadow></value><value name=\"subtitle\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow></value><next><block type=\"gameSplash\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" _expanded=\"0\" _input_init=\"true\"></mutation><value name=\"title\"><shadow type=\"text\"><field name=\"TEXT\">\"The battle for the princess awaits ...\"</field></shadow></value><value name=\"subtitle\"><shadow type=\"text\"><field name=\"TEXT\"></field></shadow></value><next><block type=\"mapplaceontile\"><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"PB(~=z`V-wG[^Zy@v(NM\">mySprite</field></block></value><value name=\"loc\"><shadow type=\"mapgettile\"><value name=\"col\"><shadow type=\"math_number\"><field name=\"NUM\">41</field></shadow></value><value name=\"row\"><shadow type=\"math_number\"><field name=\"NUM\">4</field></shadow></value></shadow></value></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"// Required project assets:\n// Tilemaps: level1, level2\n// Image: KNIGHTSPRITE\n// Animations: skellyWalkLeft, skellyWalkRight,\n//             skellyAttackLeft, skellyAttackRight,\n//             forestBatLeft, forestBatRight,\n//             forestBatAttackLeft, forestBatAttackRight,\n//             heart\n// Images: forestLargeMushroom1, forestLargeMushroom0,\n//         forestMushroomPatch\n// Tiles: stairLadder, collectibleBlueCrystal,\n//        collectibleInsignia, collectibleRedCrystal,\n//        transparency16, TILEDOWN, SWORDCHEST, OPEN CHEST\n//\n// Both tilemaps are 53 by 20 tiles. Mark actual floors/platforms\n// as walls in the tilemap editor.\n\nconst HERO_SPEED = 75\nconst CLIMB_SPEED = 48\nconst JUMP_SPEED = -170\nconst GRAVITY = 400\nconst ENEMY_SPEED = 20\n\nconst LEVEL1_START_COL = 50\nconst LEVEL1_START_ROW = 15\nconst LEVEL2_START_COL = 50\nconst LEVEL2_START_ROW = 15\nconst PRINCESS_COL = 2\nconst PRINCESS_ROW = 4\nconst LEVEL1_ENEMY_COL = 39\nconst LEVEL1_ENEMY_ROW = 16\n\nnamespace SpriteKind {\n    export const Climbable = SpriteKind.create()\n    export const Checkpoint = SpriteKind.create()\n    export const Skeleton = SpriteKind.create()\n    export const Bat = SpriteKind.create()\n    export const Coin = SpriteKind.create()\n    export const Potion = SpriteKind.create()\n    export const Princess = SpriteKind.create()\n    export const Heart = SpriteKind.create()\n}\n\nenum GameAction {\n    WalkLeft,\n    WalkRight,\n    AttackLeft,\n    AttackRight,\n    HeartBeat\n}\n\nenum GameMode {\n    Playing,\n    WaitingForLevel2,\n    Ending\n}\n\nlet hero: Sprite = null\nlet princess: Sprite = null\nlet healthBar: StatusBarSprite = null\n\nlet climbables: Sprite[] = []\nlet enemies: Sprite[] = []\nlet stageSprites: Sprite[] = []\n\nlet levelNumber = 1\nlet mode = GameMode.Playing\nlet gameStarted = false\nlet climbing = false\nlet attacking = false\nlet facingRight = true\nlet hitCooldown = false\nlet hasSword = false\n\nlet coinsCollected = 0\nlet enemiesDefeated = 0\nlet startTime = 0\n\nfunction clampNumber(value: number, low: number, high: number): number {\n    return Math.max(low, Math.min(high, value))\n}\n\nfunction trackStageSprite(sprite: Sprite): Sprite {\n    stageSprites.push(sprite)\n    return sprite\n}\n\nfunction clearStageSprites() {\n    for (let sprite of stageSprites) {\n        if (sprite) {\n            sprite.destroy()\n        }\n    }\n\n    stageSprites = []\n    enemies = []\n    climbables = []\n    princess = null\n}\n\nfunction tileCenterX(col: number): number {\n    return tiles.getTileLocation(col, 0).x\n}\n\nfunction tileBottomY(row: number): number {\n    return tiles.getTileLocation(0, row).bottom\n}\n\nfunction placeAtTileBottom(sprite: Sprite, col: number, row: number) {\n    placeSpriteBottomAt(sprite, tileCenterX(col), tileBottomY(row))\n}\n\nfunction placeSpriteBottomAt(sprite: Sprite, x: number, bottomY: number) {\n    sprite.setPosition(x, bottomY - sprite.height / 2)\n}\n\nfunction markerLocations(tile: Image): tiles.Location[] {\n    return tiles.getTilesByType(tile)\n}\n\nfunction clearMarker(location: tiles.Location) {\n    tiles.setWallAt(location, false)\n    tiles.setTileAt(location, assets.tile`transparency16`)\n}\n\nfunction setEnemyAction(enemy: Sprite, action: GameAction) {\n    if (sprites.readDataNumber(enemy, \"action\") != action) {\n        sprites.setDataNumber(enemy, \"action\", action)\n        animation.setAction(enemy, action)\n    }\n}\n\nfunction attachSkeletonAnimations(skeleton: Sprite) {\n    animation.attachAnimation(\n        skeleton,\n        assets.animation`skellyWalkLeft`\n    )\n    animation.attachAnimation(\n        skeleton,\n        assets.animation`skellyWalkRight`\n    )\n    animation.attachAnimation(\n        skeleton,\n        assets.animation`skellyAttackLeft`\n    )\n    animation.attachAnimation(\n        skeleton,\n        assets.animation`skellyAttackRight`\n    )\n\n    sprites.setDataNumber(skeleton, \"action\", -1)\n    setEnemyAction(skeleton, GameAction.WalkLeft)\n}\n\nfunction attachBatAnimations(bat: Sprite) {\n    animation.attachAnimation(\n        bat,\n        assets.animation`forestBatLeft`\n    )\n    animation.attachAnimation(\n        bat,\n        assets.animation`forestBatRight`\n    )\n    animation.attachAnimation(\n        bat,\n        assets.animation`forestBatAttackLeft`\n    )\n    animation.attachAnimation(\n        bat,\n        assets.animation`forestBatAttackRight`\n    )\n\n    sprites.setDataNumber(bat, \"action\", -1)\n    setEnemyAction(bat, GameAction.WalkLeft)\n}\n\nfunction placeHeroAt(col: number, row: number) {\n    placeAtTileBottom(hero, col, row)\n    hero.vx = 0\n    hero.vy = 0\n    hero.ay = GRAVITY\n    climbing = false\n}\n\nfunction addClimbableImage(asset: Image, location: tiles.Location) {\n    let prop = trackStageSprite(\n        sprites.create(asset, SpriteKind.Climbable)\n    )\n\n    placeSpriteBottomAt(prop, location.x, location.bottom)\n    climbables.push(prop)\n}\n\nfunction spawnClimbablesFromMarkers() {\n    let markers = markerLocations(assets.tile`collectibleBlueCrystal`)\n\n    for (let marker of markers) {\n        let choice = Math.randomRange(0, 3)\n\n        if (choice == 0) {\n            addClimbableImage(\n                assets.image`forestLargeMushroom1`,\n                marker\n            )\n        } else if (choice == 1) {\n            addClimbableImage(\n                assets.image`forestLargeMushroom0`,\n                marker\n            )\n        } else if (choice == 2) {\n            addClimbableImage(\n                assets.image`forestMushroomPatch`,\n                marker\n            )\n        } else {\n            // The ladder is a tile, so place it into the map at the marker.\n            tiles.setWallAt(marker, false)\n            tiles.setTileAt(marker, assets.tile`stairLadder`)\n        }\n\n        if (choice < 3) {\n            clearMarker(marker)\n        }\n    }\n}\n\nfunction addSkeletonAt(location: tiles.Location) {\n    let skeleton = trackStageSprite(\n        sprites.create(image.create(24, 24), SpriteKind.Skeleton)\n    )\n\n    placeSpriteBottomAt(skeleton, location.x, location.bottom)\n    skeleton.ay = GRAVITY\n\n    // Constrain skeleton movement to an approximate cell around its marker.\n    sprites.setDataNumber(skeleton, \"minX\", location.x - 56)\n    sprites.setDataNumber(skeleton, \"maxX\", location.x + 56)\n    sprites.setDataNumber(skeleton, \"homeY\", location.y)\n    sprites.setDataNumber(skeleton, \"speed\", ENEMY_SPEED)\n    sprites.setDataNumber(skeleton, \"action\", -1)\n    sprites.setDataNumber(skeleton, \"attackUntil\", 0)\n\n    attachSkeletonAnimations(skeleton)\n    enemies.push(skeleton)\n}\n\nfunction addBatAt(location: tiles.Location) {\n    let bat = trackStageSprite(\n        sprites.create(image.create(16, 16), SpriteKind.Bat)\n    )\n\n    bat.setPosition(location.x, location.y)\n\n    // Bats can fly, but stay near the marker's level and cell.\n    sprites.setDataNumber(bat, \"minX\", location.x - 56)\n    sprites.setDataNumber(bat, \"maxX\", location.x + 56)\n    sprites.setDataNumber(bat, \"minY\", location.y - 32)\n    sprites.setDataNumber(bat, \"maxY\", location.y + 32)\n    sprites.setDataNumber(bat, \"homeY\", location.y)\n    sprites.setDataNumber(bat, \"speed\", ENEMY_SPEED)\n    sprites.setDataNumber(bat, \"action\", -1)\n    sprites.setDataNumber(bat, \"attackUntil\", 0)\n\n    attachBatAnimations(bat)\n    enemies.push(bat)\n}\n\nfunction spawnEnemiesFromMarkers() {\n    let markers = markerLocations(assets.tile`collectibleInsignia`)\n\n    for (let marker of markers) {\n        if (Math.randomRange(0, 1) == 0) {\n            addSkeletonAt(marker)\n        } else {\n            addBatAt(marker)\n        }\n\n        clearMarker(marker)\n    }\n\n    // Level 1 does not have insignia spawn markers yet.\n    if (markers.length == 0 && levelNumber == 1) {\n        addSkeletonAt(\n            tiles.getTileLocation(LEVEL1_ENEMY_COL, LEVEL1_ENEMY_ROW)\n        )\n    }\n\n    // Keep level 2 playable even if its spawn markers were accidentally removed.\n    if (markers.length == 0 && levelNumber == 2) {\n        addSkeletonAt(\n            tiles.getTileLocation(LEVEL1_ENEMY_COL, LEVEL1_ENEMY_ROW)\n        )\n    }\n}\n\nfunction addCoinAt(location: tiles.Location) {\n    let coin = trackStageSprite(\n        sprites.create(assets.image`coin0`, SpriteKind.Coin)\n    )\n    coin.setPosition(location.x, location.y)\n}\n\nfunction addPotionAt(location: tiles.Location) {\n    let potion = trackStageSprite(\n        sprites.create(assets.image`potion10`, SpriteKind.Potion)\n    )\n    potion.setPosition(location.x, location.y)\n}\n\nfunction spawnItemsFromMarkers() {\n    let markers = markerLocations(assets.tile`collectibleRedCrystal`)\n\n    for (let marker of markers) {\n        if (Math.randomRange(0, 1) == 0) {\n            addCoinAt(marker)\n        } else {\n            addPotionAt(marker)\n        }\n\n        clearMarker(marker)\n    }\n}\n\nfunction createPrincess() {\n    // Reuses the princess sprite from the pasted level 1 code.\n    princess = trackStageSprite(\n        sprites.create(img`\n            . . . . . f f 4 4 f f . . . .\n            . . . . f 5 4 5 5 4 5 f . . . .\n            . . . f e 4 5 5 5 5 4 e f . .\n            . . f b 3 e 4 4 4 4 e 3 b f .\n            . . f 3 3 3 3 3 3 3 3 3 3 f .\n            . f 3 3 e b 3 e e 3 b e 3 3 f .\n            . f 3 3 f f e e e e f f 3 3 f .\n            . f b b f b f e e f b f b b f .\n            . f b b e 1 f 4 4 f 1 e b b f .\n            f f b b f 4 4 4 4 4 4 f b b f f\n            f b b f f f e e e e f f f b b f\n            . f e e f b d d d d b f e e f .\n            . . e 4 c d d d d d d c 4 e . .\n            . . e f b d b d b d b b f e . .\n            . . . f f 1 d 1 d 1 d f f . . .\n            . . . . . f f b b f f . . . . .\n        `, SpriteKind.Princess)\n    )\n\n    placeAtTileBottom(princess, PRINCESS_COL, PRINCESS_ROW)\n}\n\nfunction showHeartAbovePrincess() {\n    if (!princess) return\n\n    let heart = trackStageSprite(\n        sprites.create(image.create(16, 16), SpriteKind.Heart)\n    )\n\n    heart.setPosition(princess.x, princess.y - 20)\n    animation.attachAnimation(heart, assets.animation`heart`)\n    animation.setAction(heart, GameAction.HeartBeat)\n}\n\nfunction beginPrincessEnding() {\n    if (mode != GameMode.Playing) return\n\n    showHeartAbovePrincess()\n\n    if (levelNumber == 1) {\n        mode = GameMode.WaitingForLevel2\n        hero.sayText(\"Press A for Level 2\", 3000)\n    } else {\n        mode = GameMode.Ending\n        hero.sayText(\"You found the princess!\", 1200)\n\n        control.runInParallel(function () {\n            pause(1500)\n\n            let elapsedSeconds =\n                Math.floor((game.runtime() - startTime) / 1000)\n            let timeBonus = Math.max(0, 3000 - elapsedSeconds * 8)\n\n            info.setScore(\n                enemiesDefeated * 300 +\n                coinsCollected * 100 +\n                timeBonus\n            )\n\n            game.over(true, effects.confetti)\n        })\n    }\n}\n\nfunction getNearbyTileLocation(\n    center: tiles.Location,\n    colOffset: number,\n    rowOffset: number\n): tiles.Location {\n    let col = clampNumber(center.column + colOffset, 0, 52)\n    let row = clampNumber(center.row + rowOffset, 0, 19)\n    return tiles.getTileLocation(col, row)\n}\n\nfunction touchingLadderTile(): boolean {\n    if (!hero) return false\n\n    let center = hero.tilemapLocation()\n\n    for (let colOffset = -1; colOffset <= 1; colOffset++) {\n        for (let rowOffset = -1; rowOffset <= 1; rowOffset++) {\n            let location = getNearbyTileLocation(\n                center,\n                colOffset,\n                rowOffset\n            )\n\n            if (\n                tiles.tileAtLocationEquals(\n                    location,\n                    assets.tile`stairLadder`\n                ) ||\n                tiles.tileAtLocationEquals(\n                    location,\n                    sprites.dungeon.stairNorth\n                ) ||\n                tiles.tileAtLocationEquals(\n                    location,\n                    sprites.dungeon.stairLadder\n                )\n            ) {\n                return true\n            }\n        }\n    }\n\n    return false\n}\n\nfunction touchingClimbableSprite(): boolean {\n    for (let prop of climbables) {\n        if (prop && prop.overlapsWith(hero)) {\n            return true\n        }\n    }\n\n    return false\n}\n\nfunction touchingClimbable(): boolean {\n    return touchingLadderTile() || touchingClimbableSprite()\n}\n\nfunction performHeroAttack() {\n    if (!hero || attacking || mode != GameMode.Playing) return\n\n    attacking = true\n\n    for (let enemy of enemies) {\n        if (!enemy) continue\n\n        let inFront =\n            facingRight\n                ? enemy.x >= hero.x - 4 && enemy.x <= hero.x + 32\n                : enemy.x <= hero.x + 4 && enemy.x >= hero.x - 32\n\n        if (inFront && Math.abs(enemy.y - hero.y) <= 26) {\n            enemiesDefeated += 1\n            enemy.destroy(effects.disintegrate, 120)\n\n            let index = enemies.indexOf(enemy)\n            if (index >= 0) {\n                enemies[index] = null\n            }\n        }\n    }\n\n    control.runInParallel(function () {\n        pause(250)\n        attacking = false\n    })\n}\n\nfunction damageHero() {\n    if (hitCooldown || !healthBar || healthBar.value <= 0) return\n\n    hitCooldown = true\n    healthBar.value -= 1\n    scene.cameraShake(3, 150)\n    hero.vy = -55\n\n    if (healthBar.value <= 0) {\n        game.over(false)\n    }\n\n    control.runInParallel(function () {\n        pause(850)\n        hitCooldown = false\n    })\n}\n\nfunction updateEnemies() {\n    for (let enemy of enemies) {\n        if (!enemy) continue\n\n        let minX = sprites.readDataNumber(enemy, \"minX\")\n        let maxX = sprites.readDataNumber(enemy, \"maxX\")\n        let speed = sprites.readDataNumber(enemy, \"speed\")\n        let homeY = sprites.readDataNumber(enemy, \"homeY\")\n        let closeToHero =\n            Math.abs(hero.x - enemy.x) < 72 &&\n            Math.abs(hero.y - enemy.y) < 52\n\n        let facingLeft = hero.x < enemy.x\n        let attackUntil = sprites.readDataNumber(enemy, \"attackUntil\")\n\n        if (closeToHero && game.runtime() >= attackUntil) {\n            sprites.setDataNumber(\n                enemy,\n                \"attackUntil\",\n                game.runtime() + 500\n            )\n            sprites.setDataNumber(\n                enemy,\n                \"attackingUntil\",\n                game.runtime() + 350\n            )\n        }\n\n        let isAttacking =\n            game.runtime() <\n            sprites.readDataNumber(enemy, \"attackingUntil\")\n\n        if (enemy.kind() == SpriteKind.Skeleton) {\n            if (closeToHero) {\n                enemy.vx = facingLeft ? -speed : speed\n            } else if (enemy.x <= minX) {\n                enemy.vx = speed\n            } else if (enemy.x >= maxX) {\n                enemy.vx = -speed\n            }\n\n            enemy.x = clampNumber(enemy.x, minX, maxX)\n\n            if (isAttacking) {\n                setEnemyAction(\n                    enemy,\n                    facingLeft\n                        ? GameAction.AttackLeft\n                        : GameAction.AttackRight\n                )\n            } else {\n                setEnemyAction(\n                    enemy,\n                    enemy.vx < 0\n                        ? GameAction.WalkLeft\n                        : GameAction.WalkRight\n                )\n            }\n        } else {\n            let minY = sprites.readDataNumber(enemy, \"minY\")\n            let maxY = sprites.readDataNumber(enemy, \"maxY\")\n\n            if (closeToHero) {\n                enemy.vx = facingLeft ? -speed : speed\n                enemy.vy = hero.y < enemy.y ? -speed : speed\n            } else {\n                if (enemy.x <= minX) enemy.vx = speed\n                if (enemy.x >= maxX) enemy.vx = -speed\n                if (enemy.y <= minY) enemy.vy = speed\n                if (enemy.y >= maxY) enemy.vy = -speed\n            }\n\n            enemy.x = clampNumber(enemy.x, minX, maxX)\n            enemy.y = clampNumber(enemy.y, minY, maxY)\n\n            if (isAttacking) {\n                setEnemyAction(\n                    enemy,\n                    facingLeft\n                        ? GameAction.AttackLeft\n                        : GameAction.AttackRight\n                )\n            } else {\n                setEnemyAction(\n                    enemy,\n                    enemy.vx < 0\n                        ? GameAction.WalkLeft\n                        : GameAction.WalkRight\n                )\n            }\n        }\n    }\n}\n\nfunction loadLevel(nextLevel: number) {\n    clearStageSprites()\n\n    levelNumber = nextLevel\n    mode = GameMode.Playing\n\n    if (levelNumber == 1) {\n        tiles.setCurrentTilemap(tilemap`level1`)\n    } else {\n        tiles.setCurrentTilemap(tilemap`level2`)\n    }\n\n    scene.setBackgroundColor(11)\n\n    if (levelNumber == 1) {\n        placeHeroAt(LEVEL1_START_COL, LEVEL1_START_ROW)\n    } else {\n        // Level 2 has enemy/object markers, not a separate hero marker.\n        placeHeroAt(LEVEL2_START_COL, LEVEL2_START_ROW)\n    }\n\n    spawnClimbablesFromMarkers()\n    spawnItemsFromMarkers()\n    spawnEnemiesFromMarkers()\n    createPrincess()\n\n    scene.cameraFollowSprite(hero)\n}\n\nfunction handleEnemyOverlap(player: Sprite, enemy: Sprite) {\n    if (attacking) {\n        enemiesDefeated += 1\n        enemy.destroy(effects.disintegrate, 120)\n    } else {\n        damageHero()\n    }\n}\n\nfunction startGame() {\n    tiles.setCurrentTilemap(tilemap`level1`)\n    scene.setBackgroundColor(11)\n\n    hero = sprites.create(\n        assets.image`KNIGHTSPRITE`,\n        SpriteKind.Player\n    )\n\n    controller.moveSprite(hero, HERO_SPEED, 0)\n    hero.ay = GRAVITY\n\n    healthBar = statusbars.create(28, 4, StatusBarKind.Health)\n    healthBar.attachToSprite(hero, 2, 0)\n    healthBar.max = 3\n    healthBar.value = 3\n\n    info.setScore(0)\n    startTime = game.runtime()\n    gameStarted = true\n\n    loadLevel(1)\n}\n\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (!gameStarted) return\n\n    if (mode == GameMode.WaitingForLevel2) {\n        loadLevel(2)\n        return\n    }\n\n    if (mode == GameMode.Playing) {\n        performHeroAttack()\n    }\n})\n\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    if (!gameStarted || mode != GameMode.Playing) return\n\n    if (\n        climbing ||\n        touchingClimbable() ||\n        hero.isHittingTile(CollisionDirection.Bottom)\n    ) {\n        climbing = false\n        hero.ay = GRAVITY\n        hero.vy = JUMP_SPEED\n\n        if (controller.dx() != 0) {\n            hero.vx = controller.dx() * HERO_SPEED\n        }\n    }\n})\n\ngame.onUpdate(function () {\n    if (!gameStarted || mode != GameMode.Playing) return\n\n    let onClimbable = touchingClimbable()\n    let upPressed = controller.up.isPressed()\n    let downPressed = controller.down.isPressed()\n\n    if (onClimbable && (upPressed || downPressed)) {\n        climbing = true\n        hero.ay = 0\n        hero.vy = downPressed ? CLIMB_SPEED : -CLIMB_SPEED\n        hero.vx = controller.dx() * HERO_SPEED\n    } else if (climbing && onClimbable) {\n        hero.ay = 0\n        hero.vy = 0\n    } else if (climbing) {\n        climbing = false\n        hero.ay = GRAVITY\n    }\n\n    if (hero.vx < -1) {\n        facingRight = false\n    } else if (hero.vx > 1) {\n        facingRight = true\n    }\n\n    if (hero.y > tileBottomY(19) + 32) {\n        if (levelNumber == 1) {\n            placeHeroAt(LEVEL1_START_COL, LEVEL1_START_ROW)\n        } else {\n            placeHeroAt(LEVEL2_START_COL, LEVEL2_START_ROW)\n        }\n\n        damageHero()\n    }\n})\n\ngame.onUpdateInterval(100, function () {\n    if (gameStarted && mode == GameMode.Playing) {\n        updateEnemies()\n    }\n})\n\n// Ladder climbing and down-only drop-through tile.\nscene.onOverlapTile(\n    SpriteKind.Player,\n    assets.tile`TILEDOWN`,\n    function (sprite, location) {\n        if (controller.down.isPressed()) {\n            hero.vy = CLIMB_SPEED\n        }\n    }\n)\n\nscene.onOverlapTile(\n    SpriteKind.Player,\n    sprites.dungeon.stairNorth,\n    function (sprite, location) {\n        if (controller.up.isPressed()) {\n            climbing = true\n            hero.ay = 0\n            hero.vy = -CLIMB_SPEED\n        }\n    }\n)\n\nscene.onOverlapTile(\n    SpriteKind.Player,\n    sprites.dungeon.stairLadder,\n    function (sprite, location) {\n        if (controller.up.isPressed()) {\n            climbing = true\n            hero.ay = 0\n            hero.vy = -CLIMB_SPEED\n        }\n    }\n)\n\nscene.onOverlapTile(\n    SpriteKind.Player,\n    assets.tile`stairLadder`,\n    function (sprite, location) {\n        if (controller.up.isPressed()) {\n            climbing = true\n            hero.ay = 0\n            hero.vy = -CLIMB_SPEED\n        }\n    }\n)\n\nscene.onOverlapTile(\n    SpriteKind.Player,\n    sprites.dungeon.chestClosed,\n    function (sprite, location) {\n        if (controller.A.isPressed()) {\n            tiles.setTileAt(location, assets.tile`OPEN CHEST`)\n            info.changeScoreBy(25)\n        }\n    }\n)\n\nscene.onOverlapTile(\n    SpriteKind.Player,\n    assets.tile`SWORDCHEST`,\n    function (sprite, location) {\n        if (controller.A.isPressed() && !hasSword) {\n            hasSword = true\n            tiles.setTileAt(location, assets.tile`OPEN CHEST`)\n            hero.sayText(\"Sword acquired!\", 1200)\n        }\n    }\n)\n\nsprites.onOverlap(\n    SpriteKind.Player,\n    SpriteKind.Skeleton,\n    handleEnemyOverlap\n)\n\nsprites.onOverlap(\n    SpriteKind.Player,\n    SpriteKind.Bat,\n    h